# Choose the provider variables that match the model passed to Harbor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional NexAU overrides.
LLM_KIND=openai_responses
LLM_REASONING_EFFORT=medium
LLM_MAX_TURNS=300
LLM_CONTEXT_WINDOW_TOKENS=200000
LLM_MAX_TOKENS=32000
NEXAU_TRACE_CHECKPOINT_SEC=30

# Optional remote task sandbox. Install with `uv sync --locked --extra cloud`.
HARBOR_NEXAU_ENV=docker
# Single-container E2B adapter:
# HARBOR_NEXAU_ENV=nexau_harbor.e2b_environment:NexAUE2BEnvironment
# Compose-capable E2B DinD adapter (also wraps ordinary single-container tasks):
# HARBOR_NEXAU_ENV=nexau_harbor.e2b_dind_environment:NexAUE2BDinDEnvironment
# HARBOR_NEXAU_E2B_DIND_TEMPLATE=harbor-nexau-dind:v1
# Both E2B adapters renew 3600-second leases up to this cumulative/provider limit.
HARBOR_NEXAU_E2B_MAX_LIFETIME_SEC=86400
# Trace mode gives each Agent ten hours by default.
HARBOR_NEXAU_TRACE_TIMEOUT_SEC=36000
# Auto-partition preflights plain E2B without running the Agent, then caches the route.
HARBOR_NEXAU_E2B_PREFLIGHT_TIMEOUT_SEC=7200
HARBOR_NEXAU_E2B_PREFLIGHT_ATTEMPTS=3
# HARBOR_NEXAU_E2B_ROUTE_CACHE=/root/.cache/harbor-nexau/e2b-routes.json
# Comma-separated hosts appended to both NO_PROXY and no_proxy in the Harbor process.
# HARBOR_NEXAU_NO_PROXY_HOSTS=e2b.app,.e2b.app,api.e2b.app,sandbox.e2b.app
# Leave these empty for official E2B. Set both when using a self-hosted E2B deployment.
E2B_API_URL=
E2B_DOMAIN=
E2B_API_KEY=

# Optional web and image tools.
SERPER_API_KEY=
GDPVAL_VLM_MODEL=
GDPVAL_VLM_API_KEY=
GDPVAL_VLM_BASE_URL=

# Override only when deliberately testing another TB3 dataset revision.
HARBOR_NEXAU_DATASET=terminal-bench/terminal-bench-3@sha256:88433fbcecd1a3f81f7a71bff4cc76c394d0edbefb7e028f90d4109b639fefba
