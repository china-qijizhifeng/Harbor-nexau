# Choose the provider variables that match the model passed to Harbor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Codex advertised model used for local metadata and tool selection.
HARBOR_NEXAU_MODEL=gpt-5.5

# Optional NexAU overrides.
LLM_MODEL=nex-agi/Nex-N2-Pro
LLM_KIND=openai_responses
LLM_REASONING_EFFORT=high
LLM_MAX_TURNS=300
LLM_CONTEXT_WINDOW_TOKENS=262144
LLM_MAX_TOKENS=32000
NEXAU_TRACE_CHECKPOINT_SEC=30

# Optional remote task sandbox. Install with `uv sync --locked --extra cloud`.
HARBOR_NEXAU_ENV=docker
# Single-container E2B adapter:
# HARBOR_NEXAU_ENV=nexau_harbor.e2b_environment:NexAUE2BEnvironment
# Compose-capable E2B DinD adapter (also wraps ordinary single-container tasks):
# HARBOR_NEXAU_ENV=nexau_harbor.e2b_dind_environment:NexAUE2BDinDEnvironment
# 8 CPU / 32 GiB profile:
# HARBOR_NEXAU_E2B_DIND_TEMPLATE=e2b-nex/harbor-nexau-dind:v1
# 16 CPU / 16 GiB / 55 GiB root-disk profile:
# HARBOR_NEXAU_E2B_DIND_TEMPLATE=s-project-e89a/harbor-nexau-dind-16c:v1
# Prewarm selected DinD tasks' Docker Hub images in one disposable E2B sandbox.
HARBOR_NEXAU_DIND_PREWARM=true
HARBOR_NEXAU_DIND_PREWARM_CONCURRENCY=2
HARBOR_NEXAU_DIND_PREWARM_TIMEOUT_SEC=60
HARBOR_NEXAU_DIND_PREWARM_ATTEMPTS=1
HARBOR_NEXAU_DIND_PREWARM_REQUIRED=false
# Each formal DinD sandbox tries the configured mirror, then the official Hub registry.
HARBOR_NEXAU_DIND_MIRROR_PULL_TIMEOUT_SEC=60
HARBOR_NEXAU_DIND_DIRECT_PULL_TIMEOUT_SEC=600
HARBOR_NEXAU_DIND_IMAGE_PULL_CONCURRENCY=1
# Both E2B adapters renew 3600-second leases up to this cumulative/provider limit.
HARBOR_NEXAU_E2B_MAX_LIFETIME_SEC=86400
# Trace mode gives each Agent ten hours by default.
HARBOR_NEXAU_TRACE_TIMEOUT_SEC=36000
# Allow dependency and Codex installation to tolerate slow package mirrors.
HARBOR_AGENT_SETUP_TIMEOUT_SEC=3600
# Give Compose/image provisioning up to 4x each task's official build timeout.
HARBOR_ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER=4
# Select `codex` to keep the model fixed while replacing the NexAU harness.
HARBOR_NEXAU_HARNESS=nexau
# Optional native Codex model overrides. For gpt-5.6-terra use:
# HARBOR_CODEX_UNIFIED_EXEC=false
# HARBOR_CODEX_CODE_MODE=true
# HARBOR_CODEX_CODE_MODE_ONLY=true
# HARBOR_CODEX_MULTI_AGENT=false
# HARBOR_CODEX_RESPONSES_BRIDGE=false
# HARBOR_CODEX_CONTEXT_WINDOW=272000
# HARBOR_CODEX_REASONING_EFFORT=max
HARBOR_CODEX_TRANSIENT_RETRY_ATTEMPTS=8
HARBOR_CODEX_TRANSIENT_RETRY_BASE_DELAY_SEC=5
HARBOR_CODEX_TRANSIENT_RETRY_MAX_DELAY_SEC=120
HARBOR_CODEX_VERSION=0.148.0
HARBOR_CODEX_UPSTREAM_MODEL=nex-agi/Nex-N2-Pro
HARBOR_CODEX_REASONING_EFFORT=high
HARBOR_CODEX_REASONING_SUMMARY=detailed
# Auto-partition preflights plain E2B without running the Agent, then caches the route.
HARBOR_NEXAU_E2B_PREFLIGHT_TIMEOUT_SEC=7200
HARBOR_NEXAU_E2B_PREFLIGHT_ATTEMPTS=3
# HARBOR_NEXAU_E2B_ROUTE_CACHE=/root/.cache/harbor-nexau/e2b-routes.json
# Comma-separated hosts appended to both NO_PROXY and no_proxy in the Harbor process.
# HARBOR_NEXAU_NO_PROXY_HOSTS=e2b.app,.e2b.app,api.e2b.app,sandbox.e2b.app
# Leave these empty for official E2B. Set both when using a self-hosted E2B deployment.
E2B_API_URL=
E2B_DOMAIN=
E2B_API_KEY=

# TB4 hybrid routing must be launched on basestream-cpu. The defaults below
# match the current i-zhangguoqiang namespace/PVC but contain no credentials.
# HARBOR_NEXAU_BASESTREAM_CONCURRENCY=1
# HARBOR_BASESTREAM_NAMESPACE=bg-agentic-coding
# HARBOR_BASESTREAM_QUEUE=bg-agentic-coding
# HARBOR_BASESTREAM_PRIORITY_CLASS=higher-priority-job
# HARBOR_BASESTREAM_PVC=i-zhangguoqiang
# HARBOR_BASESTREAM_PVC_HOST_ROOT=/gpfs/users/i-zhangguoqiang
# HARBOR_BASESTREAM_CONTROL_ROOT=/gpfs/users/i-zhangguoqiang/terminal-code/Harbor-nexau/.basestream
# HARBOR_BASESTREAM_API_HOST=10.1.2.7:31000
# HARBOR_BASESTREAM_NORTHJOB_CONFIG=/root/.config/northjob/userinfo.conf
# HARBOR_BASESTREAM_REGISTRY_REPOSITORY=harbor.local.clusters/zhangguoqiang/harbor-tb4
# HARBOR_BASESTREAM_REGISTRY_AUTH_PATH=/gpfs/users/i-zhangguoqiang/info/.posttrainbench-secrets/harbor-kaniko-config.json
# HARBOR_BASESTREAM_REGISTRY_AUTH_SUBPATH=info/.posttrainbench-secrets/harbor-kaniko-config.json
# HARBOR_BASESTREAM_REGISTRY_TLS_VERIFY=false
# HARBOR_BASESTREAM_HARBOR_IP=10.51.6.8
# HARBOR_BASESTREAM_SKOPEO_IMAGE=m.daocloud.io/quay.io/skopeo/stable@sha256:47853bb9fb24202af9110531ebd6e43c5f97701254ca290596640290d17942f4
# Keep one layer in flight across the single SSH-backed egress stream.
# HARBOR_BASESTREAM_SKOPEO_PARALLEL_COPIES=1
# Optional only when that mirror is reachable through the CPU egress proxy.
# HARBOR_BASESTREAM_DOCKER_HUB_MIRROR=
# HARBOR_BASESTREAM_EGRESS_STATE_PATH=/gpfs/users/i-zhangguoqiang/terminal-code/NexMLTask/gpu_manager/deploy/basestream/.state.json
# HARBOR_BASESTREAM_EXCLUDED_GPU_NODES=node-b300-001,node-b300-002,node-b300-003,node-b300-004,node-b300-005,node-b300-006,node-b300-007,node-b300-008
# HARBOR_BASESTREAM_BUILD_TIMEOUT_SEC=7200
# HARBOR_BASESTREAM_START_TIMEOUT_SEC=7200
# HARBOR_BASESTREAM_RUNTIME_LIFETIME_SEC=43200

# Optional web and image tools.
SERPER_API_KEY=
GDPVAL_VLM_MODEL=
GDPVAL_VLM_API_KEY=
GDPVAL_VLM_BASE_URL=

# Override only when deliberately testing another TB3 dataset revision.
HARBOR_NEXAU_DATASET=terminal-bench/terminal-bench-3@sha256:88433fbcecd1a3f81f7a71bff4cc76c394d0edbefb7e028f90d4109b639fefba
